<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows for "One person" (Android 12+). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="2dp">

    <TextView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/widget_preview_avatar"
        android:gravity="center"
        android:text="@string/widget_preview_initial"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_preview_pill"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/widget_preview_first"
        android:textColor="@color/text_black"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
