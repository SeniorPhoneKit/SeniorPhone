<?xml version="1.0" encoding="utf-8"?>
<!-- The full width, two rows by default; the helper can make it taller (up to a
     whole page) but not one cell small: a list of names needs the width. Never
     refreshed on a timer: PhoneWidgets redraws it when the contacts change. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_favourites_description"
    android:initialLayout="@layout/widget_favourites"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="80dp"
    android:previewImage="@drawable/ic_launcher_contacts"
    android:previewLayout="@layout/widget_favourites_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
