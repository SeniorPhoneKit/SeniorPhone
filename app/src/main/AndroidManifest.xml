<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A phone app without a phone line has nothing to do. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- The incoming-call screen over the lock screen, and its notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 12+: other apps' overlays are hidden while "Call X?" asks (Ui.confirm),
         so nothing can be drawn over the question to trick a tap. Normal permission. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- Android 11+ only lets us see SeniorLauncher's lock if we say we look for it. -->
    <queries>
        <provider android:authorities="app.phueber.seniorlauncher.lock" />
        <!-- SeniorNav: whether its Back & Home bar is visible right now (NavBar). -->
        <provider android:authorities="app.phueber.seniornav.bar" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="35">

        <!-- Two icons on the home screen, because seniors look for "Phone" and
             "Contacts" separately: "Contacts" opens the contact list. APP_CONTACTS
             lets launchers (SeniorLauncher's first-run tiles) find it as the
             contacts app. -->
        <activity
            android:name=".ContactsActivity"
            android:exported="true"
            android:icon="@drawable/ic_launcher_contacts"
            android:label="@string/contacts_app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_CONTACTS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- "Show the call log" (e.g. the system's missed-call shortcut): the
                 app has no call-log screen, the contact list is where calling starts.
                 Sent with only the type, no URL (as for every phone app). -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/calls" />
            </intent-filter>
        </activity>

        <!-- "Phone" on the home screen: the number pad. Also the target of "dial
             this number" from other apps; the DIAL filters are what Android
             requires of a default phone app (role DIALER). Its own task affinity,
             so tapping "Phone" never brings up the contact list or the other way
             round; opened from the contact list it stays in that list's task. -->
        <activity
            android:name=".DialActivity"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:taskAffinity="app.phueber.seniorphone.dial"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ContactActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <activity
            android:name=".EditContactActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- Incoming and ongoing calls: full screen, over the lock screen.
             directBootAware, like CallService and CallActionReceiver: before the
             first unlock after a restart Telecom only binds a phone app that can
             run then, else the stock dialer shows the call. -->
        <activity
            android:name=".CallActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- Telecom binds this while a call exists, because we are the default
             phone app. Ringing stays with the system (no IN_CALL_SERVICE_RINGING),
             so the phone rings with its normal ringtone and volume. -->
        <service
            android:name=".CallService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".CallActionReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Missed calls: as the phone app, Telecom sends us the count instead of
             posting its own notification. Exported for Telecom; a forged broadcast
             can at most show a notification whose Call back still asks first. -->
        <receiver
            android:name=".MissedCalls"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>
        <!-- The missed-call notification swiped away: clears the missed calls in
             Telecom, so only our own notification may send it. -->
        <receiver
            android:name=".MissedCalls$Seen"
            android:exported="false" />
        <!-- What a missed-call tap opens when the caller is no contact: the pad or
             the list, through these aliases so that only our notification (never
             another app) can mark the missed calls as seen (MissedCalls.seenFrom). -->
        <activity-alias
            android:name=".MissedCallDial"
            android:exported="false"
            android:targetActivity=".DialActivity" />
        <activity-alias
            android:name=".MissedCallList"
            android:exported="false"
            android:targetActivity=".ContactsActivity" />

        <!-- Automation (Trigly, Tasker, ...): see Automation.java. Screens that must
             appear: an invisible trampoline that never places a call, only asks
             "Call X?" like ACTION_DIAL. -->
        <activity
            android:name=".AutomationActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="app.phueber.seniorphone.action.CALL" />
                <action android:name="app.phueber.seniorphone.action.OPEN_CONTACT" />
                <action android:name="app.phueber.seniorphone.action.OPEN_DIALPAD" />
                <action android:name="app.phueber.seniorphone.action.OPEN_CONTACTS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets: one person (one cell) and the favourites (wide).
             See PhoneWidgets. A tap only ever opens "Call …?". -->
        <receiver
            android:name=".PersonWidget"
            android:exported="true"
            android:label="@string/widget_person_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_person" />
        </receiver>
        <receiver
            android:name=".FavouritesWidget"
            android:exported="true"
            android:label="@string/widget_favourites_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_favourites" />
        </receiver>
        <service
            android:name=".ContactsChangedJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Choosing the widget's person. Exported: older home screens start it
             themselves. It only accepts our own one-person widgets. -->
        <activity
            android:name=".WidgetPickActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:windowSoftInputMode="stateHidden|adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Lock, unlock, colours: the helper's settings, no permission needed
             (the lock is a guard rail, not security). -->
        <receiver
            android:name=".AutomationReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="app.phueber.seniorphone.action.LOCK" />
                <action android:name="app.phueber.seniorphone.action.UNLOCK" />
                <action android:name="app.phueber.seniorphone.action.SET_THEME" />
            </intent-filter>
        </receiver>

        <!-- Answer, hang up, speaker, louder: only for senders that hold
             ANSWER_PHONE_CALLS themselves, so no app gains call control through us. -->
        <receiver
            android:name=".CallControlReceiver"
            android:exported="true"
            android:permission="android.permission.ANSWER_PHONE_CALLS">
            <intent-filter>
                <action android:name="app.phueber.seniorphone.action.ANSWER" />
                <action android:name="app.phueber.seniorphone.action.HANG_UP" />
                <action android:name="app.phueber.seniorphone.action.SPEAKER" />
                <action android:name="app.phueber.seniorphone.action.LOUDER" />
            </intent-filter>
        </receiver>
        <!-- The settings backup for SeniorLauncher's "all Senior apps" (export,
             import). Exported without a permission: the apps have separate
             signing keys; BackupProvider answers only SeniorLauncher and this app. -->
        <provider
            android:name=".BackupProvider"
            android:authorities="app.phueber.seniorphone.backup"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
